# 이 파일을 .env로 복사하고 실제 값을 입력하세요. .env는 Git에서 제외됩니다.
# 값에 공백이나 특수 문자가 있으면 작은따옴표로 감싸세요.

# 국립중앙도서관 ISBN 서지정보 인증키
NLK_CERT_KEY=''

# YES24 도서 API 키. 조회 연동 전이라 아직 사용하지 않습니다.
YES24_API_KEY=''

# 선택 사항: 키가 비어 있는 조회처는 건너뜁니다.
KAKAO_REST_API_KEY=''
GOOGLE_BOOKS_KEY=''

# JWT 서명 키는 32바이트 이상을 사용하세요.
# 아래 명령으로 생성한 값을 입력하고 주석을 해제하세요.
# openssl rand -hex 32
# DOKPAMINE_JWT_SECRET=''

# 운영 PostgreSQL을 사용할 때만 값을 입력하고 주석을 해제하세요.
# SPRING_PROFILES_ACTIVE=prod
# DB_URL='jdbc:postgresql://localhost:5432/dokpamine'
# DB_USERNAME=''
# DB_PASSWORD=''
