# 이 파일을 .env로 복사하고 실제 값을 입력하세요. .env는 Git에서 제외됩니다.
# 값에 공백이나 특수 문자가 있으면 작은따옴표로 감싸세요.
# 주석 줄에는 등호를 쓰지 마세요. IntelliJ는 등호가 있는 # 줄도 변수로 읽습니다.

# 국립중앙도서관 ISBN 서지정보 인증키
NLK_CERT_KEY=''

# YES24 도서 API 키. 앞표지, 책등, 상품 링크, 분야, 쪽수 조회에 사용합니다.
YES24_API_KEY=''

# 선택 사항: 키가 비어 있는 조회처는 건너뜁니다.
KAKAO_REST_API_KEY=''
GOOGLE_BOOKS_KEY=''

# JWT 서명 키는 32바이트 이상을 사용하세요. 항목이 없으면 local 프로필의 개발용 기본값을 씁니다.
# 직접 지정하려면 openssl rand -hex 32로 만든 값을 DOKPAMINE_JWT_SECRET 항목으로 추가하세요.

# 운영 PostgreSQL 설정(SPRING_PROFILES_ACTIVE, DB_URL, DB_USERNAME, DB_PASSWORD)은
# 이 파일에 두지 말고 서버 환경 변수로 설정하세요.
